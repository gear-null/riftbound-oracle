  {
   "text": "Once each turn, when an enemy unit dies while I'm at a battlefield, play a Gold gear token exhausted.",
   "status": "approx",
   "node": "abilities[0]",
   "reason": "two parts are approximated. `Once each turn` is the `frequency_only` atom (CR 383.3.e, 1 gauntlet clause), declared and outside the active cut, so this script makes a Gold for EVERY enemy unit that dies; and `while I'm at a battlefield` is a condition on this unit's own location, which `where` expresses as the event's location instead."
  }
 ],
 "tests": [
  {
   "name": "an enemy unit dying at a battlefield mints a Gold",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "battlefields": [
     "Minefield"
    ],
    "seats": [
