node_modules/

# Build output. `oracle package` writes the release archive here; the archive
# is distributed via GitHub releases rather than committed, since it is
# regenerated byte-identically from the corpus on demand.
dist/
print/

# Working directory for `oracle gear-gaps`: downloaded artwork plus a stub
# to transcribe from. Completed entries belong in manifests/card-overlays.yaml.
gear-gaps/

# Card artwork is never redistributed. The index is a generated list of Riot
# CDN URLs — each user builds their own with `npm run oracle card-index`.
output/card-index.json

# Belt-and-braces: a community Q&A corpus was evaluated and dropped, and the
# crawler is gone. This keeps any leftover local copy from being committed.
output/unofficial-riftjudge-rulings*.md

# Raw source files (PDFs, HTML saves, API dumps) — not tracked
sources/**
!sources/*/
!sources/*/README.md

# ...except art-references, which is personal tooling rather than a pipeline
# input: card images plus a script that assembles them into a reference PDF for
# an external notebook. Its output is card artwork, which this project never
# redistributes, and the script is useless without the images — so the whole
# folder stays local, README included.
sources/art-references/

# Python
__pycache__/
*.pyc
.venv

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Keys
.config

# Local agent tooling — scratch from design/skill sessions, never part of the
# product. `.od-skills/` is OpenDesign's own; `plugin-source/` is where it
# stages skill folders mid-run.
.od-skills/
plugin-source/
