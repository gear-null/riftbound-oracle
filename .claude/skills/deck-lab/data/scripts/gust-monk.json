        "card": "Cithria of Cloudfield",
        "at": "battlefield"
       }
      ]
     },
     {
      "seat": 1
     }
    ]
   },
   "when": {
    "do": "play",
    "card": "Gust Monk",
    "seat": 0,
    "to": "base"
   },
   "choices": [
