   "text": "Once each turn, when an enemy unit dies while I'm at a battlefield, play a Gold gear token exhausted.",
   "status": "implemented",
   "node": "abilities[0]"
  }
 ],
 "tests": [
  {
   "name": "an enemy unit dying while he stands out mints a Gold",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "battlefields": [
     "Minefield"
    ],
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Pyke - Returned",
        "at": "battlefield"
       }
      ]
     },
     {
      "seat": 1,
      "board": [
       {
        "card": "Cithria of Cloudfield",
        "at": "battlefield"
       }
      ]
     }
    ]
   },
   "when": {
    "do": "kill",
    "card": "Cithria of Cloudfield",
    "seat": 1
   },
   "then": [
    {
     "expect": "board_count",
     "seat": 0,
     "card": "Gold",
     "n": 1
    },
    {
     "expect": "state",
     "card": "Gold",
     "seat": 0,
     "is": "exhausted"
    }
   ]
  },
  {
   "name": "the second enemy death that turn mints nothing",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "battlefields": [
     "Minefield"
    ],
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Pyke - Returned",
        "at": "battlefield"
       },
       {
        "card": "Gold",
        "at": "base",
        "token": true
       }
      ]
     },
     {
      "seat": 1,
      "board": [
       {
        "card": "Cithria of Cloudfield",
        "at": "battlefield"
       },
       {
        "card": "Kinkou Initiate",
        "at": "battlefield"
       }
      ]
     }
    ]
   },
   "when": {
    "do": "kill",
    "card": "Kinkou Initiate",
    "seat": 1
   },
   "then": [
    {
     "expect": "board_count",
     "seat": 0,
     "card": "Gold",
     "n": 1
    }
   ]
  },
  {
   "name": "with Pyke at his base, nothing triggers at all",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "battlefields": [
     "Minefield"
    ],
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Pyke - Returned",
        "at": "base"
       }
      ]
     },
     {
      "seat": 1,
      "board": [
       {
        "card": "Cithria of Cloudfield",
        "at": "battlefield"
       }
      ]
     }
    ]
   },
   "when": {
    "do": "kill",
    "card": "Cithria of Cloudfield",
    "seat": 1
   },
   "then": [
    {
     "expect": "board_count",
     "seat": 0,
     "card": "Gold",
     "n": 0
    }
   ]
  }
 ],
