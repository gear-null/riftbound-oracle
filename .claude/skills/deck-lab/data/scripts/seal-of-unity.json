 "tests": [
  {
   "name": "it adds one Order Power to the pool",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Seal of Unity",
        "at": "base"
       }
      ]
     },
     {
      "seat": 1
     }
    ]
   },
   "when": {
    "do": "activate",
    "card": "Seal of Unity",
    "seat": 0
   },
   "then": [
    {
     "expect": "power",
     "seat": 0,
     "domain": "Order",
     "n": 1
    },
    {
     "expect": "state",
     "card": "Seal of Unity",
     "seat": 0,
     "is": "exhausted"
    }
   ]
  },
  {
   "name": "an exhausted Seal cannot pay its own cost again",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Seal of Unity",
        "at": "base",
        "exhausted": true
       }
      ]
     },
     {
      "seat": 1
     }
    ]
   },
   "when": {
    "do": "activate",
    "card": "Seal of Unity",
    "seat": 0
   },
   "then": [
    {
     "expect": "refused",
     "reason": "already exhausted"
    }
   ]
  }
