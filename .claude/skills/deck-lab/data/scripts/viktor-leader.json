{
 "schema": "riftbound-card-script/1",
 "card": "Viktor - Leader",
 "source": "manual",
 "notes": "The `not` is what stops the loop the printed card forbids: a Recruit token dying must not mint another. Inside a negation a token spec names a KIND and creates nothing, which is why it carries no Might.",
 "abilities": [
  {
   "kind": "triggered",
   "cites": [
    "CR:382",
    "CR:383"
   ],
   "trigger": {
    "events": [
     "die"
    ],
    "who": "you",
    "what": {
     "type": "unit",
     "side": "friendly",
     "another": true,
     "not": {
      "token": {
       "name": "Recruit",
       "type": "unit"
      }
     }
    }
   },
   "effect": [
    {
     "op": "play",
     "to": "base",
     "cites": [
      "CR:419",
      "CR:179"
     ],
     "what": {
      "token": {
       "name": "Recruit",
       "type": "unit",
       "might": 1
      }
     }
    }
   ]
  }
 ],
 "clauses": [
  {
   "text": "When another non-Recruit unit you control dies, play a 1 :rb_might: Recruit unit token into your base.",
   "status": "implemented",
   "node": "abilities[0]"
  }
 ],
 "tests": [
  {
   "name": "a dying ally leaves a Recruit behind",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Viktor - Leader",
        "at": "base"
       },
       {
        "card": "Cithria of Cloudfield",
        "at": "base"
       }
      ]
     },
     {
      "seat": 1
     }
    ]
   },
   "when": {
    "do": "kill",
    "card": "Cithria of Cloudfield",
    "seat": 0
   },
   "then": [
    {
     "expect": "board_count",
     "seat": 0,
     "card": "Recruit",
     "n": 1
    },
    {
     "expect": "might",
     "card": "Recruit",
     "seat": 0,
     "n": 1
    }
   ]
  },
  {
   "name": "a dying Recruit does not replace itself",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Viktor - Leader",
        "at": "base"
       },
       {
        "card": "Recruit",
        "at": "base",
        "token": true
       }
      ]
     },
     {
      "seat": 1
     }
    ]
   },
   "when": {
    "do": "kill",
    "card": "Recruit",
    "seat": 0
   },
   "then": [
    {
     "expect": "board_count",
     "seat": 0,
     "card": "Recruit",
     "n": 0
    }
   ]
  },
  {
   "name": "Viktor dying is not ANOTHER unit dying",
   "given": {
    "turn_player": 0,
    "phase": "main",
    "seats": [
     {
      "seat": 0,
      "board": [
       {
        "card": "Viktor - Leader",
        "at": "base"
       }
      ]
     },
     {
      "seat": 1
     }
    ]
   },
   "when": {
    "do": "kill",
    "card": "Viktor - Leader",
    "seat": 0
   },
   "then": [
    {
     "expect": "board_count",
     "seat": 0,
     "card": "Recruit",
     "n": 0
    }
   ]
  }
 ],
 "version": "sha256:eea74d15ae625c60"
}
