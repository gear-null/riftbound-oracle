# Riftcodex API base URL (card data)
RIFTCODEX_API_URL=https://api.riftcodex.com

# Optional: mirror output/ into an Obsidian vault's raw/ folder for `oracle vault-sync`.
# No default — this points at a personal vault, so it must be set explicitly.
# VAULT_RAW_DIR=/path/to/Obsidian/Wiki/raw/riftbound

# Optional: override where the rules-report skill looks for the corpus.
# Defaults to this repo's output/ directory, which `oracle process` + `oracle extract` fill.
# RIFTBOUND_CORPUS=/path/to/corpus
